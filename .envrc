# direnv config — run `direnv allow` after cloning.
#
# Adds the NVSHMEM shared library to LD_LIBRARY_PATH so EXLA can load its
# CUDA 13 NIF. NVSHMEM is shipped as a Python wheel (nvidia-nvshmem-cu12)
# and lives in the uv/pip cache; find it with:
#
#   find ~/.cache -name "libnvshmem_host.so*" 2>/dev/null
#
# Adjust the path below if your cache location differs.

NVSHMEM_LIB=$(python3 -c "import nvidia.nvshmem; import os; print(os.path.join(os.path.dirname(nvidia.nvshmem.__file__), 'lib'))" 2>/dev/null)

if [ -n "$NVSHMEM_LIB" ]; then
  export LD_LIBRARY_PATH="$NVSHMEM_LIB:${LD_LIBRARY_PATH:-}"
fi
